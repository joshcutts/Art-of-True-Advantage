---
import { Image } from 'astro:assets';
import bookcover from '../assets/book_cover.jpg'
import Countdown from '../components/Countdown.astro'

const LAUNCH_DATE = new Date("2026-06-08T00:00:00-07:00");
const isLaunched = new Date() >= LAUNCH_DATE;
---

<section id="landing">
  <h1 class="visually-hidden">The Art of True Advantage - Launching June 8, 2026</h1>
  
  <div class="image-wrapper">
    <Image 
      src={bookcover} 
      class="outline" 
      alt="the ART of TRUE ADVANTAGE" 
      width={500}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <div class="content-bundle">
    {isLaunched ? (
      <div class="badge-container">
        <h2 class="launch-badge">Available <span class="highlight">Now</span></h2>
        <span class="extra-sparkle s1"></span>
        <span class="extra-sparkle s2"></span>
        <span class="extra-sparkle s3"></span>
        <span class="extra-sparkle s4"></span>
        <span class="extra-sparkle s5"></span>
        <span class="extra-sparkle s6"></span>
        <span class="extra-sparkle s7"></span>
        <span class="extra-sparkle s8"></span>
        <span class="extra-sparkle s9"></span>
        <span class="extra-sparkle s10"></span>
        <span class="extra-sparkle s11"></span>
        <span class="extra-sparkle s12"></span>
        <span class="extra-sparkle s13"></span>
        <span class="extra-sparkle s14"></span>
        <span class="extra-sparkle s15"></span>
        <span class="extra-sparkle s16"></span>
        <span class="extra-sparkle s17"></span>
        <span class="extra-sparkle s18"></span>
        <span class="extra-sparkle s19"></span>
        <span class="extra-sparkle s20"></span>
        <span class="extra-sparkle s21"></span>
        <span class="extra-sparkle s22"></span>
        <span class="extra-sparkle s23"></span>
        <span class="extra-sparkle s24"></span>
        <span class="extra-sparkle s25"></span>
        <span class="extra-sparkle s26"></span>
        <span class="extra-sparkle s27"></span>
      </div>
    ) : (
      <Countdown deadline="2026-06-08T00:00:00-07:00" />
    )}
    
    <div class="cta-buttons">
      {isLaunched ? (
        <>
          <a href="https://www.amazon.com/dp/B0H1NJ93WT" class="btn btn-primary" target="_blank" rel="noopener noreferrer">
            Buy Paperback
          </a>
          <a href="https://www.amazon.com/dp/B0H195XGG1" class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
            Read on Kindle
          </a>
        </>
      ) : (
        <>
          <a href="https://www.amazon.com/dp/B0H195XGG1" class="btn btn-primary" target="_blank" rel="noopener noreferrer">
            Pre-Order on Kindle
          </a>
        </>
      )}
    </div>
  </div>
</section>

<style>
.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.outline {
  width: 100%;
  border: 1px solid;
  height: auto;
  border-image-source: linear-gradient(135deg, #d78941, #8e5a2b);
  border-image-slice: 1;
  box-shadow: 0 10px 30px rgba(0,0,0,0.4);
}

main {
  width: 100%;
  max-width: 1200px;
  display: flex;
  justify-content: center;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
}

#landing {
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  gap: .5rem;
  padding: 1rem 1rem;
  width: 100%;
  box-sizing: border-box;
}

.image-wrapper {
  width: 100%;
  max-width: 320px;
  display: flex;
  justify-content: center;
}

.content-bundle {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: min-content; 
  min-width: 600px;
}

.cta-buttons {
  display: flex;
  flex-direction: row;
  gap: 0.85rem;
  align-items: center;
  width: 100%;
  max-width: 600px;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 0.95rem 1.5rem;
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  text-decoration: none;
  border-radius: 4px;
  box-sizing: border-box;
  white-space: nowrap;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.btn-primary {
  background: #d78941;
  color: #000000;
  border: 1px solid #d78941;
  box-shadow: 0 4px 12px rgba(215, 137, 65, 0.2);
}

.btn-primary:hover {
  background: #c37633;
  border-color: #c37633;
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(215, 137, 65, 0.35);
}

.btn-primary:active {
  transform: translateY(-0.5px);
}

.btn-secondary {
  /* This is a warm, undeniable medium-dark coffee/wood brown */
  background: #6b4423;
  
  /* Upgraded text to a crisp cream metallic tone so it sits beautifully on warm brown */
  color: #f6e7d9;              
  border: 1px solid #6b4423;
  box-shadow: 0 4px 12px rgba(107, 68, 35, 0.1);
}

.btn-secondary:hover {
  /* Shift to a rich velvet mahogany on hover */
  background: #7d5331;         
  border-color: #d78941;       /* Brand gold accent on the border only */
  color: #ffffff;              /* Flash to white text for ultimate hover clarity */
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(107, 68, 35, 0.2);
}

.btn-secondary:active {
  transform: translateY(-0.5px);
}

.badge-container {
  position: relative;
  display: inline-block;
  margin-top: 1rem; /* Balanced buffer below the cover */
}

.launch-badge {
  font-size: 2.5rem;
  font-weight: 900;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  text-align: center;
  line-height: 1.1;
  color: #1a1510; 
  background-image: linear-gradient(135deg, #1a1510 0%, #3a2e22 50%, #5c4936 100%);
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  filter: drop-shadow(0px 1px 2px rgba(26, 21, 16, 0.15));
}

.extra-sparkle {
  content: "";
  position: absolute;
  filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.9)) drop-shadow(0 0 4px rgba(138, 154, 171, 0.4));
  background-color: #d78941;
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg width='160' height='160' viewBox='0 0 160 160' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M80 0C80 0 84.2846 41.2925 101.496 58.504C118.707 75.7154 160 80 160 80C160 80 118.707 84.2846 101.496 101.496C84.2846 118.707 80 160 80 160C80 160 75.7154 118.707 58.504 101.496C41.2925 84.2846 0 80 0 80C0 80 41.2925 75.7154 58.504 58.504C75.7154 41.2925 80 0 80 0Z' fill='black'/%3E%3C/svg%3E");
  mask-image: url("data:image/svg+xml,%3Csvg width='160' height='160' viewBox='0 0 160 160' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M80 0C80 0 84.2846 41.2925 101.496 58.504C118.707 75.7154 160 80 160 80C160 80 118.707 84.2846 101.496 101.496C84.2846 118.707 80 160 80 160C80 160 75.7154 118.707 58.504 101.496C41.2925 84.2846 0 80 0 80C0 80 41.2925 75.7154 58.504 58.504C75.7154 41.2925 80 0 80 0Z' fill='black'/%3E%3C/svg%3E");
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  animation: comeau-twinkle 2.5s linear infinite;
  opacity: 0;
}

/* Sparkle Offsets */
.s1  { width: 22px; height: 22px; top: -2px;  left: 10px;  animation-delay: 0.8s; }
.s2  { width: 20px; height: 20px; top: 5%;    right: 5px;  animation-delay: 2.2s; }
.s3  { width: 24px; height: 24px; bottom: .5px; right: 25%; animation-delay: 1.2s; }
.s4  { width: 16px; height: 16px; bottom: 4px;  right: 50%; animation-delay: 0.6s; }
.s5  { width: 22px; height: 22px; top: 12px;   left: 20px;  animation-delay: 1.5s; }
.s6  { width: 10px; height: 10px; top: -4px;  left: 20px;  animation-delay: 0.9s; }
.s7  { width: 22px; height: 22px; top: -6px;  left: 50px;  animation-delay: 1.9s; }
.s8  { width: 8px;  height: 8px;  top: -8px;  left: 40px;  animation-delay: 0.6s; }
.s9  { width: 18px; height: 18px; top: -8px;  right: 70px; animation-delay: 1.2s; }
.s10 { width: 18px; height: 18px; top: -2px;  right: 50px; animation-delay: 0.2s; }
.s11 { width: 21px; height: 21px; top: -8px;  right: 42px; animation-delay: 1.5s; }
.s12 { width: 17px; height: 17px; top: -8px;  right: 38px; animation-delay: 1.8s; }
.s13 { width: 10px; height: 10px; top: 12px;  left: 35%;  animation-delay: 0.4s; }
.s14 { width: 8px;  height: 8px;  top: 4px;   left: 42%;  animation-delay: 1.7s; }
.s15 { width: 11px; height: 11px; bottom: 2px; left: 48%;  animation-delay: 2.1s; }
.s16 { width: 6px;  height: 6px;  top: 18px;  left: 52%;  animation-delay: 0.9s; }
.s17 { width: 12px; height: 12px; bottom: 6px; left: 58%;  animation-delay: 1.3s; }
.s18 { width: 7px;  height: 7px;  top: 8px;   left: 65%;  animation-delay: 0.5s; }
.s19 { width: 9px;  height: 9px;  top: 22px;  left: 38%;  animation-delay: 1.1s; }
.s20 { width: 11px; height: 11px; top: -2px;  left: 46%;  animation-delay: 2.4s; }
.s21 { width: 8px;  height: 8px;  bottom: 8px; left: 41%;  animation-delay: 0.2s; }
.s22 { width: 10px; height: 10px; top: 14px;  left: 55%;  animation-delay: 1.6s; }
.s23 { width: 6px;  height: 6px;  bottom: 4px; left: 62%;  animation-delay: 0.8s; }
.s24 { width: 12px; height: 12px; top: 2px;   left: 60%;  animation-delay: 1.9s; }
.s25 { width: 9px;  height: 9px;  top: 10px;  left: 49%;  animation-delay: 1.5s; }
.s26 { width: 7px;  height: 7px;  bottom: 10px; left: 34%; animation-delay: 2.3s; }
.s27 { width: 10px; height: 10px; top: -4px;  left: 67%;  animation-delay: 0.7s; }

@keyframes comeau-twinkle {
  0% { transform: scale(0) rotate(0deg); opacity: 0; }
  15% { transform: scale(1.2) rotate(60deg); opacity: 1; }
  30% { transform: scale(0) rotate(120deg); opacity: 1; }
  100% { transform: scale(0) rotate(180deg); opacity: 0; }
}

@media (min-width: 768px) and (max-height: 820px) {
  #landing {
    gap: 0.5rem;
    padding-bottom: 3rem;
  }
  .image-wrapper {
    max-width: 280px;
  }
}

/* ==========================================
   CONSOLIDATED MOBILE ADJUSTMENTS
   ========================================== */
@media (max-width: 480px) {
  #landing {
    padding: 1.5rem 1rem;
    gap: 1.25rem;
  }

  .image-wrapper {
    max-width: 180px;
  }

  .content-bundle {
    width: 100%;
    min-width: 0;
    max-width: 290px;
  }

  .launch-badge {
    font-size: 1.8rem;
    letter-spacing: 0.12em;
    margin-bottom: 1.5rem;
  }

  .cta-buttons {
    flex-direction: column;
    gap: 0.85rem;
  }
  
  .btn {
    padding: 0.85rem 1.25rem;
    font-size: 0.8rem;
    white-space: normal;
  }
}
</style>

<script defer define:vars={{ LAUNCH_DATE }}>
  function checkLaunchTime() {
    const targetTime = new Date(LAUNCH_DATE).getTime();
    const currentTime = new Date().getTime();
    const timeRemaining = targetTime - currentTime;

    if (timeRemaining > 0) {
      setTimeout(() => {
        window.location.reload();
      }, timeRemaining);
    }
  }

  checkLaunchTime();
</script>