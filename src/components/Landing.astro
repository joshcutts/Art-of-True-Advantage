---
import bookcover from '../assets/book_cover.jpg'
import Countdown from '../components/Countdown.astro'
---

<section id="landing">
  <div class="image-wrapper">
    <img src={bookcover.src} class="outline" alt="the ART of TRUE ADVANTAGE" />
  </div>
  <Countdown deadline="2026-06-08T00:00:00-07:00" />
</section>

<style>
.outline {
  width: 100%;
  border: 1px solid;
  /* Creates a gradient from your orange to a darker version */
  border-image-source: linear-gradient(135deg, #d78941, #8e5a2b);
  border-image-slice: 1;
  box-shadow: 0 10px 30px rgba(0,0,0,0.4);
}

  .launch-team {
    display: flex;
    justify-content: center;
  }

	main {
		width: 100%;
    max-width: 1200px;
		display: flex;
		justify-content: center;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
	}

	#landing {
		display: flex;
		align-items: center;
		flex-direction: column;
		justify-content: center;
		padding: 16px;
	}

  .image-wrapper {
    width: 100%;
    max-width: 320px;
    display: flex;
    justify-content: center;
  }

  @media (max-width: 480px) {
    #landing {
      padding: 1.5rem 1rem;
      gap: 1.5rem; /* Tightens the gap so the timer pulls up higher */
    }
    
    .image-wrapper {
      max-width: 180px; /* Scales the book cover down on small mobile phones */
    }
  }
</style>


