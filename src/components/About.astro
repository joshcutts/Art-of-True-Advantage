---
import { Image } from 'astro:assets'
import bookcover_new from '../assets/book_cover_new.png'
---
<section id="about" class="about-section">
  
  <div class="about-header-striking">
    <h2 class="about-title">About the Book</h2>
  </div>

  <div class="split">
    <Image 
      src={bookcover_new} 
      class="outline" 
      alt="book cover" 
    />
    
    <div class="about-text-block">
      <h3>Improve Your Mindset, Elevate Your Results.</h3>
      <p class="intro-phrase">Harness and develop your innate ability to:</p>
      
      <ul class="values-list">
        <li>Respond to challenges and difficulty in a positive and productive manner.</li>
        <li>Lead yourself and others effectively and compassionately.</li>
        <li>Enjoy meaningful and fulfilling relationships.</li>
        <li>Live a life that is reflective of your deepest values.</li>
      </ul>
      
      <p class="blueprint-p">All of us have far more influence than we routinely realize. The <em>Art of True Advantage</em> is the blueprint for becoming more effective at using the influence we have to craft the life we deeply want to lead.</p>
    </div>
  </div>

  <div class="about-footer-striking">
    <h2 class="footer-title">Orientation Drives Outcomes.</h2>
  </div>
</section>

<style>
  /* Ensure universal box sizing across Astro's scoped boundaries */
  .about-section,
  .about-header-striking,
  .about-footer-striking,
  .split,
  .outline,
  .about-text-block {
    box-sizing: border-box !important;
  }

  .about-section {
    display: flex;
    align-items: center;
    flex-direction: column;
    padding: 60px 20px; 
    background-color: #f8f3df;
    scroll-margin-top: 80px;
    width: 100%;
  }

  /* ==========================================
     FORTIFIED ABOUT STRIKING HEADER STYLES
     ========================================== */
  .about-header-striking,
  .about-footer-striking {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important; 
    justify-content: center !important;
    width: 100% !important;
    max-width: 1100px !important; 
  }

  .about-header-striking {
    margin: 0 auto 50px auto !important; 
  }

  .about-footer-striking {
    margin: 50px auto 0 auto !important; 
  }

  .about-header-striking h2.about-title,
  .about-footer-striking h2.footer-title {
    font-family: "Inter", "Helvetica Neue", sans-serif !important;
    font-weight: 800 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.2em !important; 
    color: #6b4423 !important; 
    margin: 0 !important;
    padding: 0 !important;
    line-height: 1 !important;
    white-space: nowrap !important; 
    border: none !important; 
    background: transparent !important;
  }

  .about-header-striking h2.about-title {
    font-size: 2.2rem !important;
  }

  .about-footer-striking h2.footer-title {
    font-size: 1.5rem !important;
    letter-spacing: 0.25em !important; /* Elegant wider tracking for the tagline statement */
  }

  .about-header-striking::before,
  .about-header-striking::after,
  .about-footer-striking::before,
  .about-footer-striking::after {
    content: "" !important;
    display: block !important;
    flex: 1 !important; 
    height: 1px !important; 
    min-height: 1px !important; 
    background-color: #d78941 !important; 
    opacity: 1 !important;
    visibility: visible !important;
  }

  .about-header-striking::before,
  .about-footer-striking::before {
    margin-right: 30px !important;
  }

  .about-header-striking::after,
  .about-footer-striking::after {
    margin-left: 30px !important;
  }

  .split {
    display: flex;
    align-items: flex-start;
    flex-direction: row;
    max-width: 1100px;
    width: 100%;
    gap: 60px; 
  }

  .outline {
    max-width: 320px;
    width: 100%;
    height: auto; 
    border: 1px solid;
    border-image-source: linear-gradient(135deg, #d78941, #8e5a2b);
    border-image-slice: 1;
    box-shadow: 0 15px 35px rgba(0,0,0,0.25);
  }

  .about-text-block {
    max-width: 650px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .about-text-block h3 {
    font-size: 1.6rem;
    color: #1a1a1a;
    margin: 0 0 25px 0;
  }

  .intro-phrase {
    font-size: 1.05rem;
    margin: 0 0 20px 0;
    color: #4a4a4a;
  }

  .values-list {
    list-style: none;
    padding: 0;
    margin: 0 0 35px 0;
  }

  .values-list li {
    margin-bottom: 15px;
    position: relative;
    padding-left: 25px;
    line-height: 1.6;
    color: #333333;
  }

  .values-list li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: #d78941;
    font-weight: bold;
  }

  .blueprint-p {
    line-height: 1.7;
    color: #222222;
    margin: 0;
    font-size: 1.05rem;
  }

  /* ==========================================
     MOBILE RESPONSIVE OVERRIDES
     ========================================== */
@media (max-width: 768px) {
  .about-header-striking {
    margin-bottom: 30px !important;
    padding: 0 5px !important;
  }

  .about-footer-striking {
    margin-top: 35px !important;
    padding: 0 5px !important;
  }

  .about-header-striking h2.about-title {
    font-size: 1.5rem !important; 
    letter-spacing: 0.15em !important;
    white-space: normal !important;
    word-wrap: break-word !important;
    text-align: center !important;
  }

  /* FIXED: Scaled down text size and padded margins to perfectly replicate the Author section's clean tracking */
  .about-footer-striking h2.footer-title {
    font-size: 0.75rem !important; 
    letter-spacing: 0.18em !important;
    white-space: nowrap !important; /* Locks it to a single line so the side tracks stay uniform */
    text-align: center !important;
  }

  .about-header-striking::before,
  .about-header-striking::after,
  .about-footer-striking::before,
  .about-footer-striking::after {
    flex: 1 !important;
  }

  .about-header-striking::before,
  .about-footer-striking::before { margin-right: 15px !important; }
  .about-header-striking::after,
  .about-footer-striking::after { margin-left: 15px !important; }

  .split {
    flex-direction: column;
    align-items: center;    
    text-align: center;     
    gap: 30px;
  }

  .outline {
    max-width: 260px;       
  }

  .about-text-block {
    width: 100%;
    align-items: center;    
  }

  .about-text-block h3 {
    font-size: 1.2rem !important; 
    text-align: center;
    width: 100%;
    white-space: normal;    
  }

  .values-list {
    text-align: left;
    display: inline-block;  
    max-width: 90%;         
    margin: 0 auto 30px auto; 
    padding: 0;
  }

  .values-list li {
    font-size: 0.95rem;     
  }
}
</style>