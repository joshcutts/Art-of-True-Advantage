---
import { Image } from 'astro:assets'
import nav_logo from '../assets/nav_logo.png'
const LAUNCH_DATE = new Date("2026-06-08T00:00:00-07:00");
const isLaunched = new Date() >= LAUNCH_DATE;
---

<nav class="navbar">
  <div class="container">
    <a href="/" class="logo">
      <Image 
        src={nav_logo} 
        id="nav-logo" 
        alt="Join the Launch Team" 
        loading="eager"
      />
    </a>

    <div class="nav-wrapper">
      <ul class="nav-links">
        {/* Added dynamic class to hide parent pseudo-elements post-launch */}
        <li class={`launch-team ${isLaunched ? 'launched' : ''}`}>
          <a href="#launchteam" class="launch-team-link">
            <span class="top-line">JOIN THE</span>
              <span class="bottom-line">LAUNCH TEAM</span>
            
            {!isLaunched && (
              <>
                <span class="extra-sparkle s1"></span>
                <span class="extra-sparkle s2"></span>
                <span class="extra-sparkle s3"></span>
                <span class="extra-sparkle s4"></span>
                <span class="extra-sparkle s5"></span>
                <span class="extra-sparkle s6"></span>
                <span class="extra-sparkle s7"></span>
                <span class="extra-sparkle s8"></span>
                <span class="extra-sparkle s9"></span>
                <span class="extra-sparkle s10"></span>
                <span class="extra-sparkle s11"></span>
                <span class="extra-sparkle s12"></span>
              </>
            )}
          </a>
        </li>
        <li><a href="#about" class="standard-link">ABOUT</a></li>
        <li><a href="#reviews" class="standard-link">REVIEWS</a></li>
        <li><a href="#author" class="standard-link">AUTHOR</a></li>
        <li><a href="#contact" class="standard-link">CONTACT</a></li>
      </ul>
    </div>
    <button class="hamburger" id="menu-toggle" aria-label="Toggle Menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<style>
  .navbar {
    padding: 1.5rem 0;
    position: sticky;
    top: 0;
    z-index: 100;
    background: #f8f3df; 
    border-bottom: 1px solid #6b4423;
  }

  .container {
    margin: 0 auto;
    display: flex;
    justify-content: flex-start;
    gap: 4rem;
    align-items: center;
    padding: 0 clamp(1.5rem, 4vw, 3rem); 
    width: 100%;
    box-sizing: border-box;
  }

  .nav-wrapper {
    margin-left: auto;
  }

  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    height: 100%
  }

  #nav-logo {
    height: 55px; 
    width: auto; 
    display: block;
    object-fit: contain;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: clamp(1rem, 2vw, 2rem);
    margin: 0;
  }

  .nav-links li {
    display: flex;
    align-items: stretch;
  }

  .nav-links a.standard-link {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: #6b4423;
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    border-top: 1px solid #d78941;
    border-bottom: 1px solid #d78941;
    transition: all 0.2s ease;
    width: 100%;
    padding: 1rem clamp(0.75rem, 1.5vw, 1.5rem);
  }

  .launch-team {
    width: 100%;
    border-top: 1px solid #d78941;
    border-bottom: 1px solid #d78941;
    display: flex;
    position: relative;
    justify-content: center;
    z-index: 1;
  }

  .launch-team-link {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-width: 150px;
    padding: .5rem 2rem;
    text-decoration: none;
    position: relative;
    z-index: 5;
  }

  /* Core Engine rules for all sparkle masking */
  .launch-team::before,
  .launch-team::after,
  .extra-sparkle {
    content: "";
    position: absolute;
    filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.9)) drop-shadow(0 0 4px rgba(138, 154, 171, 0.4));
    background-color: #d78941;
    -webkit-mask-image: url("data:image/svg+xml,%3Csvg width='160' height='160' viewBox='0 0 160 160' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M80 0C80 0 84.2846 41.2925 101.496 58.504C118.707 75.7154 160 80 160 80C160 80 118.707 84.2846 101.496 101.496C84.2846 118.707 80 160 80 160C80 160 75.7154 118.707 58.504 101.496C41.2925 84.2846 0 80 0 80C0 80 41.2925 75.7154 58.504 58.504C75.7154 41.2925 80 0 80 0Z' fill='black'/%3E%3C/svg%3E");
    mask-image: url("data:image/svg+xml,%3Csvg width='160' height='160' viewBox='0 0 160 160' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M80 0C80 0 84.2846 41.2925 101.496 58.504C118.707 75.7154 160 80 160 80C160 80 118.707 84.2846 101.496 101.496C84.2846 118.707 80 160 80 160C80 160 75.7154 118.707 58.504 101.496C41.2925 84.2846 0 80 0 80C0 80 41.2925 75.7154 58.504 58.504C75.7154 41.2925 80 0 80 0Z' fill='black'/%3E%3C/svg%3E");
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    animation: comeau-twinkle 2.5s linear infinite;
    opacity: 0;
  }

  /* Only allow structural background sparkles to fire if the site isn't launched */
  .launch-team:not(.launched)::before {
    width: 20px; height: 20px;
    top: 5px; right: 10px;
    animation-delay: 0s;
  }

  .launch-team:not(.launched)::after {
    width: 15px; height: 15px;
    bottom: 5px; left: 15px;
    animation-delay: 0.2s;
  }

  /* Explicitly suppress structural pseudo-elements when launched */
  .launch-team.launched::before,
  .launch-team.launched::after {
    display: none !important;
    content: none !important;
  }

  /* Positional coordinate scopes for inner text sparkles */
  .s1 { width: 12px; height: 12px; top: 2px; left: 10px; animation-delay: 0.8s; }
  .s2 { width: 10px; height: 10px; top: 5%; right: 5px; animation-delay: 2.2s; }
  .s3 { width: 14px; height: 14px; bottom: 2px; right: 15px; animation-delay: 1.2s; }
  .s4 { width: 6px; height: 6px; bottom: 4px; left: 45%; animation-delay: 0.6s; }
  .s5 { width: 12px; height: 12px; top: 15px; left: 15px; animation-delay: 1.5s; }
  .s6 { width: 8px; height: 8px; top: -2px; left: 25px; animation-delay: 0.9s; }
  .s7 { width: 12px; height: 12px; top: 0px; left: 50px; animation-delay: 1.9s; }
  .s8 { width: 10px; height: 10px; top: -4px; left: 40px; animation-delay: 0.6s; }
  .s9 { width: 8px; height: 8px; top: -2px; right: 50px; animation-delay: 1.2s; }
  .s10 { width: 8px; height: 8px; top: 18px; right: 35px; animation-delay: 0.2s; }
  .s11 { width: 11px; height: 11px; top: -4px; right: 20px; animation-delay: 1.5s; }
  .s12 { width: 7px; height: 7px; top: 20px; right: 15px; animation-delay: 1.8s; }

  @keyframes comeau-twinkle {
    0% { transform: scale(0) rotate(0deg); opacity: 0; }
    15% { transform: scale(1.2) rotate(60deg); opacity: 1; }
    30% { transform: scale(0) rotate(120deg); opacity: 1; }
    100% { transform: scale(0) rotate(180deg); opacity: 0; }
  }

  .nav-links a:hover .bottom-line {
    color: #bf7635;
  }

  .nav-links a {
    text-decoration: none;
    color: #6b4423;
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    transition: color 0.2s;
    line-height: 1;
  }

  .nav-links a:hover {
    color: #d78941;
  }

  .top-line {
    font-size: 0.7rem;
    opacity: 0.8;
  }

  .bottom-line {
    font-size: 1.1rem;
    font-weight: 800;
    color: #d78941;
    white-space: nowrap;
  }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 10px;
  }

  .hamburger span {
    display: block;
    width: 25px;
    height: 3px;
    background-color: #6b4423;
    transition: 0.3s;
  }

  @media (max-width: 1155px) { 
    .container {
      padding: 0 1rem;
      justify-content: space-between;
      gap: 0;
    }
    
    .nav-links {
      display: none; 
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: auto;
      right: 0;
      width: max-content; 
      min-width: 200px; 
      background: #f8f3df;
      padding: .25rem 0; 
      border: 1px solid #6b4423; 
      border-radius: 4px;
      box-shadow: 0 10px 25px rgba(107, 68, 35, 0.15); 
      gap: 0;
    }

    .nav-links.active {
      display: flex; 
    }

    .hamburger {
      display: flex; 
      flex-shrink: 0;
    }

    .nav-links li, .nav-links li:not(.launch-team) {
      width: 100%;
      border: none; 
      display: block; 
    }

    .nav-links a.standard-link, .launch-team-link {
      border: none;
      padding: 1rem 2rem; 
      width: 100%;
      box-sizing: border-box;
      text-align: left; 
      justify-content: flex-start;
    }

    .nav-links a:hover {
      background-color: rgba(215, 137, 65, 0.08);
    }
  }
</style>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const navLinks = document.querySelector('.nav-links');
  
  menuToggle?.addEventListener('click', (e) => {
    e.stopPropagation(); 
    navLinks?.classList.toggle('active');
    menuToggle.classList.toggle('is-active');
  });

  const individualLinks = document.querySelectorAll('.nav-links a');
  individualLinks.forEach(link => {
    link.addEventListener('click', () => {
      navLinks?.classList.remove('active');
      menuToggle?.classList.remove('is-active');
    });
  });

  document.addEventListener('click', (event) => {
    const isMenuOpen = navLinks?.classList.contains('active');
    if (isMenuOpen && !menuToggle?.contains(event.target as Node) && !navLinks?.contains(event.target as Node)) {
      navLinks?.classList.remove('active');
      menuToggle?.classList.remove('is-active');
    }
  });
</script>