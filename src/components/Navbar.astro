@keyframes comeau-twinkle {
  0% {
    transform: scale(0) rotate(0deg);
    opacity: 0;
  }
  /* THE BURST: It reaches full size and 1.0 opacity very quickly */
  15% {
    transform: scale(1.2) rotate(60deg); /* Only rotated 30 degrees so far */
    opacity: 1;
  }
  /* THE FADE: It shrinks back down quickly, but the rotation isn't done */
  30% {
    transform: scale(0) rotate(120deg);
    opacity: 1;
  }
  /* THE FINISH: It stays invisible but finishes the 180-degree rotation 
     This ensures that the NEXT time it appears, it starts from a 'fresh' angle */
  100% {
    transform: scale(0) rotate(180deg);
    opacity: 0;
  }
}


