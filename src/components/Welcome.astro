---
import bookcover from '../assets/book_cover.jpg'
import Countdown from '../components/Countdown.astro'
---

<div id="container">
	<main>
		<section id="main">
			<Countdown deadline="2026-06-08T00:00:00-07:00" />
			<img src={bookcover.src} class="outline" style="max-width:350px" alt="the ART of TRUE ADVANTAGE" />
    </section>
    <section id="launch-team">
      <h2>Join Launch Team</h2>
      <h3>What is the Launch Team?</h3>
      <p>Support the Art of True Advantage launch by joining the launch team</p>
      <p>Stay informed about the book release and special events</p>
      <p>Receive exclusive invitation to the Launch Team Celebratory Book Signing</p>
      <div class="contact-form">
        <form action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="e0113dd9-ab2c-4165-bae7-978a1dc2cffb">
          <input style="width:500px" type="text" name="Name" placeholder="Full Name" required>
          <input style="width:500px" type="text" name="email" placeholder="email" required>
          <button type="submit" class="btn">JOIN THE LAUNCH TEAM</button>
        </form>
      </div>
    </section>
    <section id="about">
      <h2>About The Art of True Advantage</h2>
      <div class="split">
        <img src={bookcover.src} style="max-width:300px"alt="book cover">
        <div class="text" style="height:450px; max-width:700px;">
        <h3 style="margin-top: 30px; margin-bottom:40px;">Improve Your Mindset, Elevate Your Results.</h3>
        <p style="margin-bottom:10px;">Harness and develop your innate ability to:</p>
        <ul>
            <li style="margin-left:25px;">Respond to challenges and difficulty in a positive and productive manner.</li>
            <li style="margin-left:25px;">Lead yourself and others effectively and compassionately.</li>
            <li style="margin-left:25px;">Enjoy meaningful and fulfilling relationships.</li>
            <li style="margin-left:25px;">Live a life that is reflective of your deepest values.</li>
        </ul>
        <p style="margin-top:40px;">All of us have far more more influence than we routinely realize. The Art of True Advantage is the blueprint for becoming more effective at using the influence we have to craft the life we deeply want to lead.</p>
      </div>
      </div>
      
    </section>
    <section id="reviews">
      <h2>Advanced Praise</h2>
    </section>
    <section id="author">
      <h2>About the Author</h2>
    </section>
    <section class="copyright">
      Copyright © ADVANTAGEOUS ORIENTATIONS PRESS, 2026. All rights reserved.
    </section>
	</main>
</div>

<style>
  .outline {
    border: 2px solid #d78941
  }
	#container {
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		height: 100%;
    display: flex;
    align-items: center;
	}

	main {
		width: 100%;
    max-width: 1200px;
		display: flex;
		justify-content: center;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
	}

	#main {
		display: flex;
		align-items: center;
		flex-direction: column;
		justify-content: center;
		padding: 16px;
	}

  .split {
    display: flex;
    align-items: center;
    flex-direction: row;
  }

	h1 {
		font-size: 22px;
		margin-top: 0.25em;
	}

</style>
