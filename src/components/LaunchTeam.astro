---
import want_you from '../assets/want_you_final.jpg'
import rocket from '../assets/noun-rocket.svg'
---

<section id="launchteam" class="launch-section">
  <div class="launch-container">

    <div class="launch-grid">
      <img src={rocket.src} id="rocket" alt="Join the Launch Team">
      <div class="launch-info">
        <h2 class="title">Launch Team</h2>
        <ul>
          <li>Support the <em>Art of True Advantage</em> launch by joining the Launch Team</li>
          <li>Stay informed about the book release and special events</li>
          <li style="font-weight: bold; font-size: 1.5em;">Receive an exclusive invitation to the Celebratory Book Signing</li>
        </ul>
      </div>
    </div>
      
    <div class="contact-section-wrapper">
      <img src={want_you.src} id="launch-graphic" alt="Join the Launch Team">
      
      <div class="contact-form">
        <form action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="e0113dd9-ab2c-4165-bae7-978a1dc2cffb">
          <div class="form-group">
            <input type="text" name="Name" placeholder="Full Name" required>
            <input type="email" name="email" placeholder="Email Address" required>
          </div>
          <button type="submit" class="btn-launch">JOIN THE LAUNCH TEAM</button>
        </form>
      </div>
    </div>
    
  </div> </section>

<style>
  .launch-section {
    width: 100%;
    padding: 60px 20px;
    display: flex;
    justify-content: center;
    scroll-margin-top: 80px;
    background-color: #1a1a1a;
  }

  .launch-container {
    max-width: 1000px;
    width: 100%;
    text-align: center;
  }

  .title {
    font-size: 3.1rem;
    font-weight: 800;
    color: #d78941;
    white-space: nowrap;
    word-spacing: .2em;
    font-style: underline;
  }

  #rocket {
    max-width: 200px;
  }

  /* Centered Wrapper for image + form combo */
  .contact-section-wrapper {
    display: flex;
    flex-direction: row;
    align-items: center; /* Centers the image and form horizontally */
    gap: 30px;
    margin-top: 40px;
  }

  #launch-graphic {
    max-width: 350px;
    width: 100%;
    border-radius: 4px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }

  .launch-grid {
    display: flex;
    justify-content: space-between;
    gap: 60px;
    text-align: left;
    margin-bottom: 60px;
  }

  .launch-info {
    flex: 1;
    white-space: nowrap;
  }

  .launch-info h2 {
    font-size: 2.5rem;
    color: #d78941;
    border-bottom: 3px solid #d78941; 
    display: block; 
    width: 100%; 
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-align: center;
  }

  .launch-info ul {
    list-style: none;
    padding: 0;
  }

  .launch-info li {
    margin-bottom: 15px;
    position: relative;
    padding-left: 25px;
    line-height: 1.5;
    font-size: 1.4em;
    color: white;
  }

  .launch-info li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: #d78941;
    font-weight: bold;
  }

  /* Form Layout */
  .contact-form {
    width: 100%;
    max-width: 550px; /* Locks entire form block to exactly match input size constraints */
    margin: 0 auto;
  }

  .contact-form form {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-bottom: 20px;
    width: 100%
  }

  .contact-form input {
    padding: 15px;
    border: 1px solid #ddd;
    border-radius: 4px;
    width: 100%; /* Spans full width of the 350px parent container */
    box-sizing: border-box; /* Prevents padding from spilling over sizing limits */
    font-family: inherit;
  }

  .btn-launch {
    background-color: #d78941;
    color: white;
    padding: 15px 40px;
    border: none;
    border-radius: 4px;
    font-weight: bold;
    cursor: pointer;
    transition: background 0.3s ease;
    letter-spacing: 1px;
    width: 100%; /* Spans full width of the 350px parent container to line up with inputs */
    box-sizing: border-box;
  }

  .btn-launch:hover {
    background-color: #b57232; /* Slightly darker shade for interactive feedback */
  }

  /* Mobile Responsive overrides */
  @media (max-width: 768px) {
    .launch-grid {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    
    .launch-info {
      white-space: normal; /* Permits clean wrapping on standard phone viewports */
    }

    .launch-info li {
      text-align: left;
    }
  }
</style>