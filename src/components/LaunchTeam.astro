---
import want_you from '../assets/want_you_final.jpg'
import rocket from '../assets/noun-rocket.svg'
import launch_team from '../assets/join_launch_team.jpg'
---

<section id="launchteam" class="launch-section">
  <div class="launch-container">

    <div class="launch-media-wrapper">
      <img src={launch_team.src} id="launch-team" alt="Join the Launch Team">
    </div>
      
    <div class="contact-section-wrapper">
      <div class="launch-info">
        <h2 class="title">Launch Team</h2>
        <ul>
          <li>Support the <em>Art of True Advantage</em> launch by joining the Launch Team</li>
          <li>Stay informed about the book release and special events</li>
          <li style="font-weight: bold; font-size: 1.3em;">Receive an exclusive invitation to the Celebratory Book Signing</li>
        </ul>
      </div>
      
      <div class="contact-form">
        <form action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="e0113dd9-ab2c-4165-bae7-978a1dc2cffb">
          <div class="form-group">
            <input type="text" name="Name" placeholder="Full Name" required>
            <input type="email" name="email" placeholder="Email Address" required>
          </div>
          <button type="submit" class="btn-launch">JOIN THE LAUNCH TEAM</button>
        </form>
      </div>
    </div>
    
  </div> 
</section>

<style>
  .launch-section {
    width: 100%;
    padding: 60px 20px;
    display: flex;
    justify-content: center;
    scroll-margin-top: 80px;
    background-color: #000000;
  }

  .launch-container {
    max-width: 1000px;
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: stretch;    /* Forces image wrapper and form column to be exact same height */
    gap: 60px;               
  }

  .title {
    font-size: 3.1rem;
    font-weight: 800;
    color: #d78941;
    white-space: nowrap;
    word-spacing: .2em;
  }

  /* Fixed Image Layout Wrapper */
  .launch-media-wrapper {
    flex: 0 0 350px;         /* Slightly widened to give the vertical image nice proportion */
    display: flex;
  }

  #launch-team {
    width: 100%;
    height: 100%;            /* Fills the stretched parent wrapper height completely */
    object-fit: cover;       /* Crops the image seamlessly to fit the height without squishing */
    object-position: center; /* Ensures the focus of the graphic stays centered */
    border-radius: 4px;
  }

  /* Content Column Adjustments */
  .contact-section-wrapper {
    flex: 1;                 
    display: flex;
    flex-direction: column;
    justify-content: space-between; /* Ensures spacing distributes cleanly to define the baseline */
    gap: 30px;
  }

  .launch-info {
    width: 100%;
  }

  .launch-info h2 {
    font-size: 2.5rem;
    color: #d78941;
    border-bottom: 3px solid #d78941; 
    display: block; 
    width: 100%; 
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-align: center;
  }

  .launch-info ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .launch-info li {
    margin-bottom: 15px;
    position: relative;
    padding-left: 25px;
    line-height: 1.5;
    font-size: 1.2em;
    color: white;
  }

  .launch-info li:last-child {
    margin-bottom: 0;       /* Removes trailing list margin to align baseline with form button */
  }

  .launch-info li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: #d78941;
    font-weight: bold;
  }

  /* Form Layout */
  .contact-form {
    width: 100%;
  }

  .contact-form form {
    display: flex;
    flex-direction: column;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-bottom: 20px;
    width: 100%
  }

  .contact-form input {
    padding: 15px;
    border: 1px solid #ddd;
    border-radius: 4px;
    width: 100%; 
    box-sizing: border-box; 
    font-family: inherit;
  }

  .btn-launch {
    background-color: #d78941;
    color: white;
    padding: 15px 40px;
    border: none;
    border-radius: 4px;
    font-weight: bold;
    cursor: pointer;
    transition: background 0.3s ease;
    letter-spacing: 1px;
    width: 100%; 
    box-sizing: border-box;
  }

  .btn-launch:hover {
    background-color: #b57232; 
  }

  /* Mobile Responsive overrides */
  @media (max-width: 768px) {
    .launch-container {
      flex-direction: column; 
      align-items: center;
      gap: 40px;            
    }

    .launch-media-wrapper {
      flex: 0 0 auto;
      width: 100%;
      max-width: 350px;      
      height: 300px;        /* Gives it a balanced block shape on mobile viewports */
    }
    
    .launch-info {
      white-space: normal; 
    }

    .launch-info h2 {
      text-align: center;
    }

    .launch-info li {
      text-align: left;
    }
  }
</style>