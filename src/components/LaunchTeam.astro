---
import { Image } from 'astro:assets'
import launch_team from '../assets/join_launch_team.jpg'
import texture_launch_team from '../assets/textured_community_logo.png'
---

<section id="launchteam" class="launch-section">
  <div class="launch-container">

    <div class="launch-media-wrapper">
      <Image 
        src={texture_launch_team}
        id="launch-team" 
        alt="Join the Community" 
      />
    </div>
      
    <div class="contact-section-wrapper">
      <div class="launch-info">
        <div class="launch-header-striking">
          <h2>JOIN THE</h2>
          <h2 class="split-line-heading">COMMUNITY</h2>
        </div>
        
        <ul>
          <li style="font-weight: bold; font-size: 1.2em; --bullet: none;">Receive the Preface and Guide to Contents from The Art of True Advantage.</li>
          <li>Stay connected through occasional articles, insights, and updates from Christopher Boyer.</li>
          <li>Join a growing community exploring how perspective shapes outcomes.</li>
        </ul>
      </div>
      
      <div class="contact-form">
        <form id="launch-team-form" action="https://assets.mailerlite.com/jsonp/2405668/forms/189550880895272325/subscribe" method="POST">
          <input type="hidden" name="ml-submit" value="1">
          <input type="hidden" name="anticsrf" value="true">
          <input type="hidden" name="redirect" value="https://www.artoftrueadvantage.com/success/">
          <div class="form-group">
            <input type="text" name="fields[name]" placeholder="Full Name" required>
            <input type="email" name="fields[email]" placeholder="Email Address" required>
          </div>
          <button type="submit" class="btn-launch">CONNECT</button>
        </form>
      </div>
    </div>
    
  </div> 
</section>

<script is:inline>
  const form = document.getElementById('launch-team-form');

  if (form) {
    form.addEventListener('submit', async function(e) {
      // Stop the browser from changing pages to the ugly JSON link
      e.preventDefault();

      const button = form.querySelector('.btn-launch');
      if (button) button.disabled = true;

      try {
        // Send the data quietly in the background exactly how MailerLite needs it
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form)
        });

        // MailerLite's jsonp endpoint sends back content type text/javascript or application/json.
        // No matter what the response body looks like, a status of 200 means it accepted the subscriber.
        if (response.ok) {
          window.location.href = "https://www.artoftrueadvantage.com/success/?v=" + Date.now();
        } else {
          alert("Something went wrong. Please check your submission and try again.");
          if (button) button.disabled = false;
        }
      } catch (error) {
        // Fallback redirect just in case strict local CORS policies intercept the reading of the response body
        window.location.href = "https://www.artoftrueadvantage.com/success/?v=" + Date.now();
      }
    });
  }
</script>

<style>
/* Ensure universal box sizing across Astro's scoped boundaries */
.launch-section,
.launch-container,
.contact-section-wrapper,
.launch-info,
.contact-form,
.contact-form form,
.form-group,
.contact-form input,
.btn-launch,
.launch-header-striking {
  box-sizing: border-box !important;
}

.launch-section {
  width: 100%;
  padding: 60px 20px;
  display: flex;
  justify-content: center;
  scroll-margin-top: 80px;
  background-color: #000000;
}

/* Base Desktop Layout */
.launch-container {
  max-width: 1000px;
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: stretch;    
  gap: 60px;               
}

/* ==========================================
   FORTIFIED LAUNCH TEAM STRIKING HEADER STYLES
   ========================================== */
.launch-header-striking {
  display: grid !important;
  /* 3 Columns: Left Line (flexible), Text Gap (snug to widest word), Right Line (flexible) */
  grid-template-columns: 1fr auto 1fr !important; 
  align-items: center !important;
  justify-items: center !important;
  width: 100% !important;
  margin: 0 0 35px 0 !important; 
  row-gap: 15px !important; /* Controls the vertical spacing between the words and the line */
}

/* Force both text headers to sit in the center column, leaving columns 1 and 3 empty */
.launch-header-striking h2 {
  grid-column: 2 !important;
  font-family: "Inter", "Helvetica Neue", sans-serif !important;
  font-size: 2.5rem !important;
  font-weight: 800 !important;
  text-transform: uppercase !important;
  letter-spacing: 0.2em !important; 
  color: #d78941 !important; 
  margin: 0 !important;
  padding: 0 !important;
  line-height: .4 !important;
  white-space: nowrap !important; 
  border: none !important; 
  background: transparent !important;
}

/* The Magic Trick: Use the container's pseudo-elements to generate the lines.
   We place them on the MIDDLE row (row 2), but let them span across columns 1 and 3.
*/
.launch-header-striking::before,
.launch-header-striking::after {
  content: "" !important;
  grid-row: 2 !important; /* Forces lines to live on the horizontal plane between the text */
  height: 1px !important;
  background-color: #d78941 !important;
  width: 100% !important;
  display: block !important;
}

/* Left line occupies column 1, pushing up against the text boundary */
.launch-header-striking::before {
  grid-column: 1 !important;
}

/* Right line occupies column 3, pulling away from the text boundary */
.launch-header-striking::after {
  grid-column: 3 !important;
}

/* Move "COMMUNITY" down to row 3 so it sits below the lines */
.split-line-heading {
  grid-row: 3 !important;
}

.launch-media-wrapper {
  flex: 0 0 275px;         
  display: flex;
}

#launch-team {
  width: 100%;
  height: 100%; 
  object-fit: cover;       
  object-position: center; 
  border-radius: 4px;
}

.contact-section-wrapper {
  flex: 1;                 
  display: flex;
  flex-direction: column;
  justify-content: space-between; 
  gap: 30px;
  min-width: 0; 
}

.launch-info {
  width: 100%;
}

.launch-info ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.launch-info li {
  margin-bottom: 15px;
  position: relative;
  padding-left: 25px;
  line-height: 1.5;
  font-size: 1.1em;
  color: white;
}

.launch-info li:last-child {
  margin-bottom: 0;       
}

.launch-info li::before {
  content: var(--bullet, "→");
  position: absolute;
  left: 0;
  color: #d78941;
  font-weight: bold;
}

.launch-info li[style*="--bullet: none"] {
  padding-left: 0;
}

.contact-form {
  width: 100%;
}

.contact-form form {
  display: flex;
  flex-direction: column;
  width: 100%;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 15px;
  margin-bottom: 20px;
  width: 100%;
}

.contact-form input {
  padding: 15px;
  border: 1px solid #ddd;
  border-radius: 4px;
  width: 100%; 
  font-family: inherit;
}

.btn-launch {
  background-color: #be742e;
  color: white;
  padding: 15px 40px;
  border: none;
  border-radius: 4px;
  font-weight: bold;
  cursor: pointer;
  transition: background 0.3s ease;
  letter-spacing: 1px;
  width: 100%; 
}

.btn-launch:hover {
  background-color: #94561f; 
}

/* Mobile Responsive overrides */
@media (max-width: 768px) {
  .launch-media-wrapper {
    display: none !important;
  }

  .launch-container {
    flex-direction: column !important; 
    align-items: center !important;
    gap: 20px !important;            
    width: 100% !important;
    max-width: 100% !important;
    overflow: hidden !important; 
  }
  
  .contact-section-wrapper {
    flex: none !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important; 
  }

  .launch-header-striking {
    margin-bottom: 25px !important;
    padding: 0 5px !important; 
  }

  .launch-header-striking h2 {
    font-size: 1.5rem !important; 
    letter-spacing: 0.15em !important;
    white-space: normal !important; 
    word-wrap: break-word !important;
    text-align: center !important;
  }

  .striking-line-separator {
    margin: 10px 0 !important; /* Tighter margins on mobile viewports */
  }

  /* Match mobile responsive transitions across sibling sections */
  .launch-header-striking::before,
  .launch-header-striking::after {
    flex: 1 !important;
  }

  .launch-header-striking::before {
    margin-right: 15px !important; 
  }

  .launch-header-striking::after {
    margin-left: 15px !important;
  }

  .launch-info ul {
    width: 100% !important;
    padding: 0 !important;
  }

  .launch-info li {
    text-align: left !important;
    font-size: 1.1em !important;
  }

  .contact-form,
  .contact-form form,
  .form-group {
    width: 100% !important;
    max-width: 100% !important;
  }
}
</style>