---
import { Image } from 'astro:assets'
import launch_team from '../assets/join_launch_team.jpg'
import texture_launch_team from '../assets/textured_launch_logo.png'
---

<section id="launchteam" class="launch-section">
  <div class="launch-container">

    <div class="launch-media-wrapper">
      <Image 
        src={texture_launch_team} 
        id="launch-team" 
        alt="Join the Launch Team" 
      />
    </div>
      
    <div class="contact-section-wrapper">
      <div class="launch-info">
        <div class="launch-header-striking">
          <h2>Launch Team</h2>
        </div>
        
        <ul>
          <li>Support the <em>Art of True Advantage</em> launch by joining the Launch Team</li>
          <li>Stay informed about the book release and special events</li>
          <li style="font-weight: bold; font-size: 1.3em;">Receive an exclusive invitation to the Celebratory Book Signing</li>
        </ul>
      </div>
      
      <div class="contact-form">
        <form action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="e0113dd9-ab2c-4165-bae7-978a1dc2cffb">
          <input type="hidden" name="_next" value="https://artoftrueadvantage.com/success">
          <div class="form-group">
            <input type="text" name="Name" placeholder="Full Name" required>
            <input type="email" name="Email" placeholder="Email Address" required>
          </div>
          <button type="submit" class="btn-launch">JOIN THE LAUNCH TEAM</button>
        </form>
      </div>
    </div>
    
  </div> 
</section>

<style>
/* Ensure universal box sizing across Astro's scoped boundaries */
.launch-section,
.launch-container,
.contact-section-wrapper,
.launch-info,
.contact-form,
.contact-form form,
.form-group,
.contact-form input,
.btn-launch,
.launch-header-striking {
  box-sizing: border-box !important;
}

.launch-section {
  width: 100%;
  padding: 60px 20px;
  display: flex;
  justify-content: center;
  scroll-margin-top: 80px;
  background-color: #000000;
}

/* Base Desktop Layout */
.launch-container {
  max-width: 1000px;
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: stretch;    
  gap: 60px;               
}

/* ==========================================
   FORTIFIED LAUNCH TEAM STRIKING HEADER STYLES
   ========================================== */
.launch-header-striking {
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important; /* Forces lines to stay dead-centered horizontally */
  justify-content: center !important;
  width: 100% !important;
  margin: 0 0 35px 0 !important; 
}

.launch-header-striking h2 {
  font-family: "Inter", "Helvetica Neue", sans-serif !important;
  font-size: 2.5rem !important;
  font-weight: 800 !important;
  text-transform: uppercase !important;
  letter-spacing: 0.2em !important; 
  color: #d78941 !important; 
  margin: 0 !important;
  padding: 0 !important;
  line-height: 1 !important;
  white-space: nowrap !important; 
  border: none !important; /* Destroys any lingering global bottom-border resets */
  background: transparent !important;
}

/* Forcing specific display and structure variables onto the pseudo-elements 
   guarantees that no global text reset can collapse the line height rules. */
.launch-header-striking::before,
.launch-header-striking::after {
  content: "" !important;
  display: block !important;
  flex: 1 !important; 
  height: 1px !important; 
  min-height: 1px !important;
  background-color: #d78941 !important; /* FIXED: Upgraded from transparent RGBA to solid brand orange */
  opacity: 1 !important;
  visibility: visible !important;
}

.launch-header-striking::before {
  margin-right: 30px !important;
}

.launch-header-striking::after {
  margin-left: 30px !important;
}

.launch-media-wrapper {
  flex: 0 0 350px;         
  display: flex;
}

#launch-team {
  width: 100%;
  height: 100%; 
  object-fit: cover;       
  object-position: center; 
  border-radius: 4px;
}

.contact-section-wrapper {
  flex: 1;                 
  display: flex;
  flex-direction: column;
  justify-content: space-between; 
  gap: 30px;
  min-width: 0; 
}

.launch-info {
  width: 100%;
}

.launch-info ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.launch-info li {
  margin-bottom: 15px;
  position: relative;
  padding-left: 25px;
  line-height: 1.5;
  font-size: 1.2em;
  color: white;
}

.launch-info li:last-child {
  margin-bottom: 0;       
}

.launch-info li::before {
  content: "→";
  position: absolute;
  left: 0;
  color: #d78941;
  font-weight: bold;
}

.contact-form {
  width: 100%;
}

.contact-form form {
  display: flex;
  flex-direction: column;
  width: 100%;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 15px;
  margin-bottom: 20px;
  width: 100%;
}

.contact-form input {
  padding: 15px;
  border: 1px solid #ddd;
  border-radius: 4px;
  width: 100%; 
  font-family: inherit;
}

.btn-launch {
  background-color: #be742e;
  color: white;
  padding: 15px 40px;
  border: none;
  border-radius: 4px;
  font-weight: bold;
  cursor: pointer;
  transition: background 0.3s ease;
  letter-spacing: 1px;
  width: 100%; 
}

.btn-launch:hover {
  background-color: #94561f; 
}

/* Mobile Responsive overrides */
@media (max-width: 768px) {
  .launch-media-wrapper {
    display: none !important;
  }

  .launch-container {
    flex-direction: column !important; 
    align-items: center !important;
    gap: 20px !important;            
    width: 100% !important;
    max-width: 100% !important;
    overflow: hidden !important; 
  }
  
  .contact-section-wrapper {
    flex: none !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important; 
  }

  .launch-header-striking {
    margin-bottom: 25px !important;
    padding: 0 5px !important; 
  }

  .launch-header-striking h2 {
    font-size: 1.5rem !important; 
    letter-spacing: 0.15em !important;
    white-space: normal !important; 
    word-wrap: break-word !important;
    text-align: center !important;
  }

  /* Match mobile responsive transitions across sibling sections */
  .launch-header-striking::before,
  .launch-header-striking::after {
    flex: 1 !important;
  }

  .launch-header-striking::before {
    margin-right: 15px !important; 
  }

  .launch-header-striking::after {
    margin-left: 15px !important;
  }

  .launch-info ul {
    width: 100% !important;
    padding: 0 !important;
  }

  .launch-info li {
    text-align: left !important;
    font-size: 1.1em !important;
  }

  .contact-form,
  .contact-form form,
  .form-group {
    width: 100% !important;
    max-width: 100% !important;
  }
}
</style>