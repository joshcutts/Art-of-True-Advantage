---
interface Props {
  deadline: string; // Format: "2026-12-31T23:59:59"
  title?: string;
}

const { deadline, title = "Launch in..." } = Astro.props;
---

<div class="countdown-container" data-deadline={deadline}>
  <div class="announcement">
    <span class="announce-top">AVAILABLE</span>
    <span class="announce-bottom">JUNE 8, 2026</span>
  </div>
  <div class="divider"></div>
  <h2>{title}</h2>
  
  <div class="timer">
    <div class="time-block">
      <span class="value" id="days">00</span>
      <span class="label">Days</span>
    </div>
    <div class="time-block">
      <span class="value" id="hours">00</span>
      <span class="label">Hours</span>
    </div>
    <div class="time-block">
      <span class="value" id="minutes">00</span>
      <span class="label">Mins</span>
    </div>
    <div class="time-block">
      <span class="value" id="seconds">00</span>
      <span class="label">Secs</span>
    </div>
  </div>
</div>

<script>
  function updateCountdown() {
    const container = document.querySelector('.countdown-container');
    if (!container) return;

    const deadline = new Date(container.getAttribute('data-deadline')!).getTime();
    
    const timer = setInterval(() => {
      const now = new Date().getTime();
      const diff = deadline - now;

      if (diff <= 0) {
        clearInterval(timer);
        container.innerHTML = "<h3>The book is now available!</h3>";
        return;
      }

      const d = Math.floor(diff / (1000 * 60 * 60 * 24));
      const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const s = Math.floor((diff % (1000 * 60)) / 1000);

      document.getElementById('days')!.textContent = d.toString().padStart(2, '0');
      document.getElementById('hours')!.textContent = h.toString().padStart(2, '0');
      document.getElementById('minutes')!.textContent = m.toString().padStart(2, '0');
      document.getElementById('seconds')!.textContent = s.toString().padStart(2, '0');
    }, 1000);
  }

  // Runs on initial load
  updateCountdown();
</script>

<style>
  .countdown-container {
    text-align: center;
    padding: 2rem 0; /* Increase padding to let it breathe */
  }

  .announcement {
    display: flex;
    flex-direction: column;
    margin-bottom: 1.5rem;
    line-height: 1.1;
  }

  .announce-top {
    font-size: 0.85rem; /* Small and spaced out like your nav-item */
    font-weight: 700;
    letter-spacing: 0.4em; 
    color: #6b4423;
    opacity: 0.6;
    margin-bottom: 0.5rem;
    font-family: "Inter", "Helvetica Neue", sans-serif;
  }

  .announce-bottom {
    font-size: 3rem; /* Huge Hero Date */
    font-weight: 900;
    color: #d78941; /* Brand color for the date */
    letter-spacing: -0.02em;
    font-family: "Playfair Display", serif; /* Match your logo's serif */
  }

  /* Replace the heavy divider with a subtle one or just space */
  .divider {
    width: 60px; /* Much smaller */
    height: 1px; /* Thinner */
    background: #d78941;
    margin: 1.5rem auto;
    opacity: 0.4;
  }

  h2 {
    font-size: 1.2rem; /* Subordinate this to the timer */
    letter-spacing: 0.3em;
    color: #6b4423;
    text-transform: uppercase;
    margin-bottom: .8rem;
  }

  .timer {
    display: flex;
    justify-content: center;
    gap: clamp(1rem, 6vw, 3rem);
  }

  .value {
    font-size: 3.5rem;
    line-height: 1;
    font-weight: 900;
    color: #6b4423;
    font-family: "Playfair Display", serif;
  }

  .label {
    font-size: 0.7rem;
    margin-top: 8px;
    font-weight: 700;
    color: #6b4423;
    opacity: 0.5;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

    /* Target tablets and laptops (like the MacBook Air) */
  @media (min-width: 768px) and (max-height: 900px) {
    .countdown-container {
      padding: 0.75rem 0; /* Compress vertical footprint */
    }

    .announcement {
      margin-bottom: 0.75rem;
    }

    .announce-bottom {
      font-size: 2.2rem; /* Scaled down smoothly from 3rem */
    }

    .divider {
      margin: 0.75rem auto;
    }

    h2 {
      font-size: 1rem;
      margin-bottom: 0.5rem;
    }

    .timer {
      gap: 2rem; /* Pull elements together slightly closer horizontally */
    }

    .value {
      font-size: 2.6rem; /* Scaled down smoothly from 3.5rem */
    }

    .label {
      font-size: 0.65rem;
      margin-top: 4px;
    }
  }

  /* Keep your existing @media (max-width: 480px) query exactly as it is below this line */

  @media (max-width: 480px) {
    .countdown-container {
      padding: 0.5rem 0; /* Compact container tracking to save screen height */
    }

    .announcement {
      margin-bottom: 0.75rem; /* Tightens space between date and micro-divider */
    }

    .announce-top {
      font-size: 0.7rem; /* Marginally smaller sub-context label */
      letter-spacing: 0.3em;
    }

    .announce-bottom {
      font-size: 1.8rem; /* Dropped from 2rem to balance nicely above smaller timer numbers */
    }

    .divider {
      margin: 0.75rem auto; /* Minimizes negative spacing gap around line breaker */
    }

    h2 {
      font-size: 0.9rem; /* Scales "Launch in..." subtitle tracking cleanly */
      margin-bottom: 0.5rem;
    }

    .timer {
      gap: 2rem; /* Clamps fixed row spacing snugly for small mobile grids */
    }

    .value {
      font-size: 2.2rem; /* Dropped down from 2.5rem to guarantee full 100% viewport safety */
    }

    .label {
      font-size: 0.6rem; /* Micro labels scale perfectly proportional to values */
      margin-top: 4px;
    }
  }
</style>