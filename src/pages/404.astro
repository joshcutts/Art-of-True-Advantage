---
// src/pages/404.astro
import { Image, getImage } from 'astro:assets'
import Layout from '../layouts/Layout.astro';
import logo from '../assets/enso.png'

const webp_logo = await getImage({ src: logo, format: 'webp', quality: 75 })
---

<Layout title="404 Page Not Found | The Art of True Advantage">
  <section class="not-found-section">
    <div class="not-found-container">
      <Image 
        src={logo}
        class="logo"
        alt="enso_logo"
      />
      <h1 class="error-number">404</h1>

      <div class="error-content">
        <h2>Page Not Found</h2>
        <p>The page you are looking for does not exist, has been removed, or has changed locations.</p>
        
        <a href="/" class="btn-home">Return to Home</a>
      </div>

    </div>
  </section>
</Layout>

<style>
  /* Ensure absolute box-sizing safety across scoped boundaries */
  .not-found-section,
  .not-found-container,
  .error-content,
  .btn-home {
    box-sizing: border-box !important;
  }

  .logo {
    width: 250px;
    height: auto;
  }

  .not-found-section {
    width: 100%;
    min-height: 70vh; 
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #000000; 
    padding: 60px 20px;
  }

  .not-found-container {
    max-width: 500px; 
    width: 100%;
    text-align: center;
  }

  .error-number {
    font-family: "Inter", "Helvetica Neue", sans-serif !important;
    font-size: 6rem !important; /* Scaled down slightly to look authoritative, not loud */
    font-weight: 800 !important;
    line-height: 1 !important;
    letter-spacing: -0.01em !important;
    color: #d78941 !important; 
    margin: 0 0 15px 0 !important;
    padding: 0 !important;
  }

  .error-content h2 {
    font-family: "Inter", "Helvetica Neue", sans-serif;
    color: #ffffff;
    font-size: 1.75rem;
    font-weight: 700;
    margin: 0 0 15px 0;
  }

  .error-content p {
    color: #b0b0b0; 
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0 0 35px 0;
  }

  .btn-home {
    display: inline-block;
    background-color: #d78941; /* Swapped back to solid brand background for clear functionality */
    color: #ffffff;
    padding: 14px 35px;
    border: none;
    border-radius: 4px;
    font-weight: bold;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.85rem;
    transition: background-color 0.2s ease;
  }

  .btn-home:hover {
    background-color: #b57232;
  }

  /* ==========================================
     RESPONSIVE MOBILE GRAPHIC SCALING
     ========================================== */
  @media (max-width: 768px) {
    .logo {
      width: 100px;
      height: auto;
    }

    .error-number {
      font-size: 4.5rem !important;
    }
    .error-content h2 { 
      font-size: 1.5rem; 
    }
    .error-content p { 
      font-size: 1rem; 
      margin-bottom: 25px;
    }
  }
</style>