---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

import desktopHeader from '../../assets/blog/blog-header-final2.png';
---

<Layout title="The Art of True Advantage | Blog">
  
  <header class="blog-header-container">
    <div class="banner-container">
      <Image 
        src={desktopHeader} 
        alt="The Art of True Advantage Blog - Orientation Outcomes" 
        class="header-graphic"
        quality="max"
        loading="eager"
      />
      
      <a href="/blog" aria-label="Blog Index" class="banner-link link-left"></a>
      <a href="/" aria-label="Back to Main Site" class="banner-link link-right"></a>
    </div>
  </header>

  <main class="blog-index">
    <section class="posts-grid">
      {sortedPosts.map(post => (
        <article class="post-card">
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </time>
          
          <h2>{post.data.title}</h2>
          <p class="summary">{post.data.summary}</p>
          
          <a href={`/blog/${post.id}`} class="read-more">Read Entry →</a>
        </article>
      ))}
    </section>
  </main>
</Layout>

<style>

  .blog-header-container {
    width: 100%;
    max-width: 1000px; 
    margin: 60px auto 40px auto;
    padding: 0 24px;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    z-index: 10;
  }

  .banner-container {
    position: relative;
    width: 100%;
  }

  .header-graphic {
    width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  /* Shared overlay link base style */
  .banner-link {
    position: absolute;
    top: 0;
    bottom: 0;
    height: 100%;
    z-index: 2; /* Sits on top of the graphic */
  }

  /* Left 35% link area */
  .link-left {
    left: 0;
    width: 35%;
  }

  /* Right 65% link area (matched to class="link-right") */
  .link-right {
    left: 35%;
    width: 65%;
  }

  /* --- 2. Centered Minimalist Content Grid --- */
  .blog-index {
    max-width: 720px; 
    margin: 0 auto 100px auto;
    padding: 0 24px;
  }

  .posts-grid {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .post-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 32px 24px; 
    margin: 0 -24px;
    background: transparent;
    border-bottom: 1px solid rgba(107, 68, 35, 0.2);
    border-radius: 8px;
    transition: background-color 0.2s ease;
    cursor: pointer;
  }

  .post-card:hover {
    background-color: rgba(107, 68, 35, 0.04);
  }

  .post-card:hover .read-more {
    color: #6B4423;
  }

  .post-card:last-child {
    border-bottom: none;
  }

  .post-card time {
    font-size: 0.85rem;
    color: #D78941;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .post-card h2 {
    font-size: 2.1rem;
    color: #6B4423;
    margin: 0 0 16px 0;
    line-height: 1.25;
    font-weight: 700;
  }

  .post-card .summary {
    color: #333333;
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .read-more {
    color: #D78941;
    font-weight: 700;
    text-decoration: none;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: color 0.2s ease;
  }

  .read-more::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
  }

  /* --- 3. Responsive Adjustments --- */
  @media (max-width: 768px) {
    .blog-header-container {
      margin-top: 40px;
      margin-bottom: 20px;
      padding: 0 16px;
    }
    
    .post-card {
      padding: 24px 16px;
      margin: 0 -16px;
    }
    
    .post-card h2 {
      font-size: 1.7rem;
    }
  }
</style>